# ── Written by `neon deploy` / `neon env pull` (don't hand-edit) ───────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ── Yours ─────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Test mode key from the same Stripe account whose pipeline syncs into this branch
STRIPE_SECRET_KEY=sk_test_
APP_URL=http://localhost:3000
# Optional: the shared demo login behind "Try the demo account" (created on first use)
DEMO_USERNAME=demo
DEMO_PASSWORD=
# Prefilled in Stripe Checkout for the demo account (default demo@example.com)
DEMO_EMAIL=demo@example.com
# Optional: model for functions/onupload.ts (read by neon.ts at deploy time)
IMAGE_MODEL=gpt-5-mini

# ── Vercel only ───────────────────────────────────────────────────────────────
# Vercel reserves AWS_* names. Copy the AWS_* values above into these instead:
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# NEON_STORAGE_ENDPOINT=
# NEON_STORAGE_REGION=
